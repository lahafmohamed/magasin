.vite/
.next/
.nuxt/
.parcel-cache/
.turbo/

# Test / coverage
coverage/
.nyc_output/
.vitest/
test-results/
playwright-report/
blob-report/
*.lcov

# Logs / process state
logs/
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches
.cache/
.eslintcache
.stylelintcache

# Local tool, IDE, and editor settings
.claude/settings.local.json
.codex/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.orig
*.rej
*~
.qwen/

