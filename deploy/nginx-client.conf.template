# Vhost nginx par client — généré par deploy/provision-client.sh
# Placeholders : {{DOMAIN}} {{SLUG}} {{API_PORT}} {{HOME}}
#
# Installation (sudo, une seule fois par client) :
#   sudo ln -s {{HOME}}/clients/{{SLUG}}/nginx-{{SLUG}}.conf /etc/nginx/sites-enabled/{{SLUG}}.conf
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d {{DOMAIN}}          # HTTPS (ajoute le bloc 443)

server {
    listen 80;
    server_name {{DOMAIN}};

    root {{HOME}}/clients/{{SLUG}}/magasin/frontend/dist;
    index index.html;

    # --- Suspension pour impayé --------------------------------------------
    # Bascule sans sudo ni reload : deploy/suspend-client.sh {{SLUG}} on|off
    # (le fichier drapeau est testé à chaque requête)
    if (-f {{HOME}}/clients/{{SLUG}}/SUSPENDED) {
        return 503;
    }
    error_page 503 /suspendu.html;
    location = /suspendu.html {
        root {{HOME}}/clients/{{SLUG}};
        internal;
    }

    # --- API ----------------------------------------------------------------
    location /api/ {
        proxy_pass http://127.0.0.1:{{API_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE (notifications) : pas de mise en tampon, connexion longue durée
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # --- Frontend (SPA React) ----------------------------------------------
    # En-têtes de sécurité sur le statique uniquement : helmet couvre /api/
    # (les poser au niveau server dupliquerait/contredirait ceux de l'API).
    # Répétés dans chaque location car l'héritage add_header de nginx est
    # tout-ou-rien : un add_header local masque ceux du niveau supérieur.
    # HSTS : ignoré en HTTP, prend effet dans le bloc 443 créé par certbot.
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # PWA : le service worker ne doit jamais être mis en cache
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    # Assets Vite fingerprintés : cache long
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    client_max_body_size 20m;
}
