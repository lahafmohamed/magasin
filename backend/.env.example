DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_NAME=magasin_db
PORT=6000
JWT_SECRET=generate-a-random-secret-key-here
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost:6001
# production | development | test
NODE_ENV=development
# Post caisse movements to the general ledger (default: off)
CAISSE_GL_POSTING=false
# API requests per 15 min — per signed-in user, or per IP when anonymous (default: 500)
RATE_LIMIT_MAX=500
# Failed login / password-change attempts per IP per 15 min (default: 10)
AUTH_RATE_LIMIT_MAX=10
